---
import BaseLayout from "../layouts/BaseLayout.astro";
import BilingualText from "../components/atoms/BilingualText.astro";
import data from "../data";
---

<BaseLayout title={data.seo.notFoundTitle} pathname="/404/">
  <section class="section" aria-labelledby="not-found-heading">
    <div class="container" style="text-align: center; gap: 1rem">
      <h1 id="not-found-heading">
        <BilingualText text={{ en: "404: Page Not Found", zh: "404：页面未找到" }} />
      </h1>
      <p>
        <BilingualText
          text={{
            en: "Sorry, the page you are looking for doesn't exist or has been moved.",
            zh: "抱歉，您访问的页面不存在或已被移动。",
          }}
        />
      </p>
      <a href="/?lang=en" data-lang-path="/" class="primary-btn">
        <BilingualText text={data.nav.home} />
      </a>
    </div>
  </section>
</BaseLayout>
