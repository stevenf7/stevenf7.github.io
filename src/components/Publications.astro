---
import "../styles/publications.scss";
import BilingualText from "./atoms/BilingualText.astro";
import data, { getText } from "../data";
import { PUBLICATION_MEDIA } from "../media";
import { isVideoFile } from "../utils/media";

const mediaGradient =
  "var(--pub-media-bottom-gradient, linear-gradient(to bottom, transparent 0%, transparent 50%, rgba(240, 248, 255, 0.5) 70%, rgba(240, 248, 255, 0.9) 85%, rgba(240, 248, 255, 1.0) 100%))";

const publications = data.publications.map((publication) => {
  const mediaSrc = PUBLICATION_MEDIA[publication.media];
  return {
    ...publication,
    mediaSrc,
    isVideo: isVideoFile(mediaSrc),
    titleEn: getText(publication.title, "en"),
  };
});
---

<section class="section" id="publications" aria-labelledby="publications-heading">
  <div class="container">
    <h2 id="publications-heading" class="fade-in-section">
      <BilingualText text={data.sections.publications} />
    </h2>
    <div class="publications-wrapper">
      <div class="grid">
        {
          publications.map((publication) => (
            <article class="publication-card fade-in-section">
              <div
                class="background-media"
                style={{
                  backgroundImage: publication.isVideo
                    ? "none"
                    : `${mediaGradient}, url(${publication.mediaSrc})`,
                }}
              >
                {publication.isVideo && (
                  <video
                    class="background-video"
                    src={publication.mediaSrc}
                    aria-label={publication.titleEn}
                    data-viewport-video
                    data-fallback-en="Video preview unavailable on this device"
                    data-fallback-zh="当前设备无法预览视频"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    disablepictureinpicture
                  />
                )}
              </div>
              <div class="content">
                <div class="publication-type" data-type={publication.type}>
                  {publication.type}
                </div>
                <h3 class="header">
                  <BilingualText text={publication.title} />
                </h3>
                <p class="subtitle">
                  <BilingualText text={publication.subtitle} />
                </p>
                {publication.projectLink && (
                  <a
                    href={publication.projectLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn"
                  >
                    <BilingualText text={data.buttons.viewPublication} />
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
