---
import BilingualText from "./atoms/BilingualText.astro";
import HeroTypewriter from "./atoms/HeroTypewriter.jsx";
import data, { getText, resolveAsset } from "../data";
import heroImage from "../images/headerphoto2.webp";

const imgUrl = resolveAsset(heroImage);
const backgroundImage = `linear-gradient(to bottom, rgba(245, 246, 252, 0) 0%, rgba(10, 18, 28, 0.18) 58%, rgba(10, 18, 28, 0.72) 100%), url(${imgUrl})`;
---

<section class="section" id="home" aria-label={getText(data.name, "en")}>
  <div class="container">
    <div class="header-wrapper" style={{ backgroundImage }}>
      <div class="hero-content">
        <h1 class="hero-name fade-in-section">
          <BilingualText text={{ en: "Hi, I'm", zh: "你好，我是" }} />
          {" "}
          <BilingualText text={data.name} />
        </h1>

        <p class="hero-role-line fade-in-section">
          <span>
            <BilingualText text={{ en: "I am a", zh: "我是一名" }} />{" "}
          </span>
          <strong class="hero-specialty">
            <HeroTypewriter client:idle />
          </strong>
        </p>

        <p class="hero-summary fade-in-section">
          <BilingualText text={data.headerParagraph} />
        </p>

        <div class="hero-actions fade-in-section">
          <a
            href="/?lang=en#nvidia"
            data-lang-path="/"
            data-lang-hash="#nvidia"
            class="primary-btn hero-primary-cta"
          >
            <BilingualText text={data.buttons.selectedWork} />
          </a>
          <a
            href="/resume?lang=en"
            data-lang-path="/resume"
            class="secondary-btn hero-secondary-cta"
          >
            <BilingualText text={data.buttons.resumeCta} />
          </a>
          <a
            href="https://www.linkedin.com/in/stevenfeng7/"
            target="_blank"
            rel="noopener noreferrer"
            class="secondary-btn hero-tertiary-cta"
          >
            <BilingualText text={data.buttons.connect} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
